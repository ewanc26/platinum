{
  "name": "@ewanc26/platinum-bridge",
  "version": "0.3.1",
  "private": true,
  "description": "Modern AT Protocol bridge for the Platinum Mac OS 9 Bluesky client",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "update": "node dist/update/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@atproto/api": "^0.23.0",
    "@atproto/oauth-client-node": "^0.5.4",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
