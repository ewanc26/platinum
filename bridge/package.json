    "check": "tsc --noEmit -p tsconfig.json"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@atproto/api": "^0.21.0",
    "@atproto/oauth-client-node": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
